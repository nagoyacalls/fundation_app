# Postgres local de desenvolvimento
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fundation_app?schema=public"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""
# URL pública da aplicação
AUTH_URL="http://localhost:3000"
# Necessário fora da Vercel (self-hosting atrás de proxy confiável)
AUTH_TRUST_HOST="true"

# App registration no Entra ID (redirect URI: <origin>/api/auth/callback/microsoft-entra-id)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# O tenant no issuer restringe o login a contas da organização
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<TENANT_ID>/v2.0"

# Chave AES-256 (32 bytes, base64) do refresh token — gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Protege /api/sync; o cron chama com header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
